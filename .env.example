# Copy to .env and adjust for your machine.
# Never commit real secrets (.env is gitignored).

# --- Database (required) ---
# Local Homebrew Postgres (typical macOS):
DATABASE_URL="postgresql://newuser@localhost:5432/expense_tracker?schema=public"

# Docker Postgres example (container mapped to host port 5433):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/expense_tracker?schema=public"

# Hosted Postgres (production) — paste from Neon / Supabase / Vercel Postgres.
# If the provider gives both "pooled" and "direct" URLs:
#   - App runtime (Vercel): often the pooled URL
#   - Migrations (`prisma migrate deploy`): often the direct URL
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth.js (required) ---
# Generate a unique value per environment (local ≠ production):
#   openssl rand -base64 32
#   # or: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Public site origin (no trailing slash). Required in production on Vercel.
# Local (optional — Auth.js can infer from the request):
# AUTH_URL="http://localhost:3000"
# Production example:
# AUTH_URL="https://your-app.vercel.app"
