# Copy to .env and adjust for your machine.
# Never commit real secrets (.env is gitignored).

# --- Database (required) ---
# Local Homebrew Postgres (typical macOS):
DATABASE_URL="postgresql://newuser@localhost:5432/expense_tracker?schema=public"

# Docker Postgres example (container mapped to host port 5433):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/expense_tracker?schema=public"

# Hosted Postgres (production) — paste from Neon / Supabase / Vercel Postgres.
# If the provider gives both "pooled" and "direct" URLs:
#   - App runtime (Vercel): often the pooled URL
#   - Migrations (`prisma migrate deploy`): often the direct URL
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth.js (required) ---
# Generate a unique value per environment (local ≠ production):
#   openssl rand -base64 32
#   # or: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Public site origin (no trailing slash). Required in production on Vercel.
# Local (optional — Auth.js can infer from the request):
# AUTH_URL="http://localhost:3000"
# Production example:
# AUTH_URL="https://your-app.vercel.app"

# Optional: session / JWT lifetime in seconds (default 2592000 = 30 days)
# AUTH_SESSION_MAX_AGE=86400

# --- Cloudflare R2 Object Storage (Receipts) ---
# Optional in local dev until testing real receipt uploads.
# R2 endpoint: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="expense-tracker-receipts"
# Optional: public custom domain or r2.dev domain (if public bucket access enabled).
# If omitted, receipts are served securely via authenticated proxy route /api/receipts/[id].
# R2_PUBLIC_DOMAIN="https://pub-xxxx.r2.dev"

# --- Transactional Email (Password Reset) ---
# Optional in local dev: if omitted, reset links are printed directly to the console
# and displayed on screen with a dev shortcut link.
# In production, provide a Resend API key: https://resend.com
# RESEND_API_KEY="re_123456789"
# EMAIL_FROM="Expense Tracker <onboarding@resend.dev>"

