// Prisma 7: do NOT put `url` here.
// Connection URL lives in prisma.config.ts (migrate) and in the client adapter (runtime).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth.js credentials + JWT: app-owned User table (no Account/Session tables required for Phase 1)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
