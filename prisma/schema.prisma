// Prisma 7: do NOT put `url` here.
// Connection URL lives in prisma.config.ts (migrate) and in the client adapter (runtime).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  name              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  categories        Category[]
  expenses          Expense[]
  budgets           Budget[]
  recurringExpenses RecurringExpense[]
  passwordResetTokens PasswordResetToken[]
  createdHouseholds   Household[]          @relation("HouseholdCreator")
  householdMembers    HouseholdMember[]
  sentHouseholdInvites HouseholdInvite[]   @relation("InvitedByUser")
  householdExpensesPaid HouseholdExpense[] @relation("HouseholdExpensePayer")
  householdSplits     HouseholdExpenseSplit[] @relation("HouseholdSplitUser")
  settlementsPaid     HouseholdSettlement[] @relation("SettlementFromUser")
  settlementsReceived HouseholdSettlement[] @relation("SettlementToUser")
}

model Category {
  id                String             @id @default(cuid())
  userId            String
  name              String
  color             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  budgets           Budget[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, name])
  @@index([userId])
}

/// How an expense was paid (personal tracker — not bank sync).
enum PaymentMethod {
  CASH
  KTB
  SCB
  BBL
  KBANK
  BAY
  TTB
  GSB
  BAAC
  CIMB
  UOB
  LH
  ICBC
  CITI
  PROMPTPAY
  OTHER
}

enum RecurringCadence {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Expense {
  id                 String            @id @default(cuid())
  userId             String
  categoryId         String
  amount             Decimal           @db.Decimal(12, 2)
  currency           String            @default("THB")
  paymentMethod      PaymentMethod     @default(CASH)
  spentAt            DateTime          @db.Date
  note               String?
  receiptUrl         String?
  receiptKey         String?
  recurringExpenseId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category           Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  @@index([userId, spentAt])
  @@index([userId, categoryId])
  @@index([userId, paymentMethod])
  @@index([userId, recurringExpenseId])
}

model Budget {
  id         String    @id @default(cuid())
  userId     String
  year       Int
  month      Int // 1–12
  /// null = overall monthly budget; set = that category only
  categoryId String?
  amount     Decimal   @db.Decimal(12, 2)
  currency   String    @default("THB")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Covers category budgets; overall budget (categoryId null) uniqueness
  // is enforced in app code since Postgres treats NULL as distinct.
  @@unique([userId, year, month, categoryId])
  @@index([userId, year, month])
}

model RecurringExpense {
  id              String           @id @default(cuid())
  userId          String
  title           String
  amount          Decimal          @db.Decimal(12, 2)
  currency        String           @default("THB")
  categoryId      String
  paymentMethod   PaymentMethod    @default(CASH)
  cadence         RecurringCadence @default(MONTHLY)
  startDate       DateTime         @db.Date
  nextDueDate     DateTime         @db.Date
  lastGeneratedAt DateTime?
  isActive        Boolean          @default(true)
  note            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  expenses        Expense[]

  @@index([userId, isActive])
  @@index([userId, nextDueDate])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum HouseholdRole {
  OWNER
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model Household {
  id          String            @id @default(cuid())
  name        String
  currency    String            @default("THB")
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  createdBy   User              @relation("HouseholdCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     HouseholdMember[]
  invites     HouseholdInvite[]
  expenses    HouseholdExpense[]
  settlements HouseholdSettlement[]

  @@index([createdById])
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@index([householdId])
}

model HouseholdInvite {
  id          String        @id @default(cuid())
  householdId String
  email       String
  role        HouseholdRole @default(MEMBER)
  status      InviteStatus  @default(PENDING)
  token       String        @unique
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy   User          @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([householdId, status])
}

enum HouseholdSplitType {
  EQUAL
  FULL
}

model HouseholdExpense {
  id          String                  @id @default(cuid())
  householdId String
  paidById    String
  amount      Decimal                 @db.Decimal(12, 2)
  currency    String                  @default("THB")
  description String
  category    String?
  spentAt     DateTime                @db.Date
  splitType   HouseholdSplitType      @default(EQUAL)
  receiptUrl  String?
  receiptKey  String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  household   Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  paidBy      User                    @relation("HouseholdExpensePayer", fields: [paidById], references: [id], onDelete: Cascade)
  splits      HouseholdExpenseSplit[]

  @@index([householdId, spentAt])
  @@index([paidById])
}

model HouseholdExpenseSplit {
  id                 String           @id @default(cuid())
  householdExpenseId String
  userId             String
  amount             Decimal          @db.Decimal(12, 2)
  isSettled          Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  expense            HouseholdExpense @relation(fields: [householdExpenseId], references: [id], onDelete: Cascade)
  user               User             @relation("HouseholdSplitUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdExpenseId, userId])
  @@index([userId])
  @@index([householdExpenseId])
}

model HouseholdSettlement {
  id          String    @id @default(cuid())
  householdId String
  fromUserId  String
  toUserId    String
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("THB")
  settledAt   DateTime  @default(now())
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  fromUser    User      @relation("SettlementFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User      @relation("SettlementToUser", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([householdId, settledAt])
  @@index([fromUserId])
  @@index([toUserId])
}



